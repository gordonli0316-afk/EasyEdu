# ============================================
# EasyEdu — environment variables
# Copy to .env for local development; set these in your
# hosting provider's dashboard for a deployment.
# ============================================

# --- Response engine -------------------------------------------------
# EASYEDU_LLM_BACKEND selects how the tutor answers:
#   deepseek   -> DeepSeek API      (needs DEEPSEEK_API_KEY)
#   tongyi     -> Tongyi/DashScope  (needs TONGYI_API_KEY)
#   local_vllm -> a self-hosted OpenAI-compatible server (needs a GPU)
#   demo       -> always use the bundled reference answers, no model at all
#
# Leave it UNSET and EasyEdu picks for you:
#   1. deepseek   if DEEPSEEK_API_KEY is set
#   2. tongyi     if TONGYI_API_KEY is set
#   3. local_vllm otherwise (http://127.0.0.1:8000/v1)
# ...and then probes that endpoint once. If it is missing, rejects the key, has no
# balance, or is unreachable, EasyEdu automatically serves answers from its bundled
# reference material so the website never breaks for a visitor. The mode is always
# reported honestly at GET /api/status.
#
# EASYEDU_LLM_BACKEND=deepseek

# Optional: force demo mode on/off regardless of reachability
# EASYEDU_DEMO_MODE=1

# --- Model provider keys (server-side only, NEVER in frontend code) ---
# Set one of these on the host; the value never reaches the browser and is never
# committed. See docs/DEPLOY.md for the Render dashboard field.
# DEEPSEEK_API_KEY=
# DEEPSEEK_MODEL=deepseek-chat
# TONGYI_API_KEY=
# TONGYI_MODEL=qwen-plus

# --- Self-hosted vLLM (GPU machine) ---------------------------------
# EASYEDU_LLM_BASE_URL=http://127.0.0.1:8000/v1
# EASYEDU_LLM_MODEL=Qwen2.5-7B-Instruct
# EASYEDU_LLM_API_KEY=EMPTY
EASYEDU_LLM_TEMPERATURE=0.7
EASYEDU_LLM_MAX_TOKENS=4096
# Bounds how long a visitor waits on a failing provider before the fallback kicks in.
EASYEDU_LLM_TIMEOUT=60
EASYEDU_LLM_MAX_RETRIES=1
EASYEDU_LLM_CONNECT_TIMEOUT=5

# --- Web app ---------------------------------------------------------
# Hosting platforms (Render/Railway/Fly) inject PORT; run_web.sh uses it.
# EASYEDU_WEB_PORT is only the local default when PORT is not set.
EASYEDU_WEB_PORT=8000
# Comma-separated origins, only needed if the frontend is served from
# a different domain. Same-origin deployments need nothing here.
# EASYEDU_CORS_ORIGINS=https://your-frontend.example.com
